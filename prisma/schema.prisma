// Reach Your Peak — SQL Server schema (Prisma 7).
//
// SQL Server notes:
// - No native enums/Json in Prisma's SQL Server connector: enum-like columns are
//   short strings validated in TypeScript (src/lib/domain.ts); JSON is NVARCHAR(MAX).
// - SQL Server rejects multiple cascade paths, so every relation sets onDelete and
//   onUpdate explicitly. Only user-owned rows cascade from User.
// - IDs never change, so onUpdate is always NoAction.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ── Better Auth core ─────────────────────────────────────────────────────────

model User {
  id            String   @id @db.NVarChar(64)
  name          String   @db.NVarChar(200)
  email         String   @unique @db.NVarChar(320)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?  @db.NVarChar(1000)
  firstName     String?  @map("first_name") @db.NVarChar(100)
  lastName      String?  @map("last_name") @db.NVarChar(100)
  /// member | admin
  role          String   @default("member") @db.NVarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions            Session[]
  accounts            Account[]
  profile             MemberProfile?
  interests           UserInterest[]
  pathGoals           PathGoal[]
  consents            Consent[]
  contentInteractions ContentInteraction[]
  userHabits          UserHabit[]
  habitLogs           HabitLog[]
  assessmentResponses AssessmentResponse[]
  activityEntries     ActivityEntry[]
  deviceConnections   DeviceConnection[]
  biometricScreenings BiometricScreening[]
  biometricGoals      BiometricGoal[]
  captainOf           Team[]
  teamMemberships     TeamMember[]
  enrollments         ChallengeEnrollment[]
  challengeProgress   ChallengeProgressDaily[]
  pointsLedger        PointsLedger[]
  redemptions         RewardRedemption[]

  @@map("user")
}

model Session {
  id        String   @id @db.NVarChar(64)
  token     String   @unique @db.NVarChar(255)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.NVarChar(64)
  userAgent String?  @map("user_agent") @db.NVarChar(1000)
  userId    String   @map("user_id") @db.NVarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.NVarChar(64)
  accountId             String    @map("account_id") @db.NVarChar(255)
  providerId            String    @map("provider_id") @db.NVarChar(64)
  userId                String    @map("user_id") @db.NVarChar(64)
  accessToken           String?   @map("access_token") @db.NVarChar(Max)
  refreshToken          String?   @map("refresh_token") @db.NVarChar(Max)
  idToken               String?   @map("id_token") @db.NVarChar(Max)
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.NVarChar(1000)
  password              String?   @db.NVarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.NVarChar(64)
  identifier String   @db.NVarChar(255)
  value      String   @db.NVarChar(Max)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ── Profile & personalization inputs ─────────────────────────────────────────

model MemberProfile {
  userId     String    @id @map("user_id") @db.NVarChar(64)
  employeeId String?   @map("employee_id") @db.NVarChar(50)
  department String?   @db.NVarChar(200)
  /// employee | spouse | retiree
  memberType String    @default("employee") @map("member_type") @db.NVarChar(20)
  timezone   String    @default("America/Denver") @db.NVarChar(64)
  onboardedAt DateTime? @map("onboarded_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("member_profiles")
}

/// Interest taxonomy; every tag belongs to one path (body | life | mind).
model Tag {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.NVarChar(100)
  label       String  @db.NVarChar(200)
  path        String  @db.NVarChar(10)
  description String? @db.NVarChar(1000)
  sortOrder   Int     @default(0) @map("sort_order")

  interests   UserInterest[]
  contentTags ContentTag[]
  habits      Habit[]

  @@map("tags")
}

model UserInterest {
  userId    String   @map("user_id") @db.NVarChar(64)
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, tagId])
  @@map("user_interests")
}

/// One goal per path, set during onboarding.
model PathGoal {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.NVarChar(64)
  path      String   @db.NVarChar(10)
  goal      String   @db.NVarChar(500)
  /// active | achieved | paused
  status    String   @default("active") @db.NVarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, path])
  @@map("path_goals")
}

/// Versioned consent records (program terms, device data, communications).
model Consent {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.NVarChar(64)
  kind      String   @db.NVarChar(50)
  version   String   @db.NVarChar(20)
  granted   Boolean
  /// JSON
  metadata  String?  @db.NVarChar(Max)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("consents")
}

// ── Content, habits, assessment ──────────────────────────────────────────────
// Recommendations are ranked at request time (rules + reason code), not stored.

model ContentItem {
  id              Int       @id @default(autoincrement())
  slug            String    @unique @db.NVarChar(150)
  title           String    @db.NVarChar(300)
  summary         String?   @db.NVarChar(1000)
  body            String?   @db.NVarChar(Max)
  /// article | video | webinar | program | recipe | resource
  type            String    @db.NVarChar(20)
  path            String    @db.NVarChar(10)
  provider        String?   @db.NVarChar(200)
  url             String?   @db.NVarChar(1000)
  imageUrl        String?   @map("image_url") @db.NVarChar(1000)
  durationMinutes Int?      @map("duration_minutes")
  /// Participation points on completion.
  points          Int       @default(0)
  /// City-pinned "Featured" window, shown above personalized items.
  featuredFrom    DateTime? @map("featured_from") @db.Date
  featuredUntil   DateTime? @map("featured_until") @db.Date
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tags         ContentTag[]
  interactions ContentInteraction[]

  @@map("content_items")
}

model ContentTag {
  contentId Int @map("content_id")
  tagId     Int @map("tag_id")

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag     Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contentId, tagId])
  @@map("content_tags")
}

model ContentInteraction {
  userId      String    @map("user_id") @db.NVarChar(64)
  contentId   Int       @map("content_id")
  viewedAt    DateTime? @map("viewed_at")
  completedAt DateTime? @map("completed_at")
  savedAt     DateTime? @map("saved_at")
  dismissedAt DateTime? @map("dismissed_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, contentId])
  @@map("content_interactions")
}

model Habit {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.NVarChar(100)
  title       String  @db.NVarChar(200)
  description String? @db.NVarChar(1000)
  path        String  @db.NVarChar(10)
  tagId       Int?    @map("tag_id")
  points      Int     @default(5)
  isActive    Boolean @default(true) @map("is_active")

  tag        Tag?        @relation(fields: [tagId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  userHabits UserHabit[]
  logs       HabitLog[]

  @@map("habits")
}

model UserHabit {
  userId    String   @map("user_id") @db.NVarChar(64)
  habitId   Int      @map("habit_id")
  active    Boolean  @default(true)
  startedAt DateTime @default(now()) @map("started_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, habitId])
  @@map("user_habits")
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.NVarChar(64)
  habitId   Int      @map("habit_id")
  logDate   DateTime @map("log_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, habitId, logDate])
  @@map("habit_logs")
}

/// Wellable-style wellbeing assessment: multi-dimension, no risk score.
model Assessment {
  id         Int     @id @default(autoincrement())
  slug       String  @unique @db.NVarChar(100)
  title      String  @db.NVarChar(200)
  version    Int     @default(1)
  /// JSON: [{ key, label, path }]
  dimensions String  @db.NVarChar(Max)
  /// JSON: [{ id, dimension, prompt, options: [{ label, value }] }]
  questions  String  @db.NVarChar(Max)
  points     Int     @default(0)
  isActive   Boolean @default(true) @map("is_active")

  responses AssessmentResponse[]

  @@map("assessments")
}

model AssessmentResponse {
  id               Int      @id @default(autoincrement())
  userId           String   @map("user_id") @db.NVarChar(64)
  assessmentId     Int      @map("assessment_id")
  /// JSON
  answers          String   @db.NVarChar(Max)
  /// JSON: per-dimension summary used to recommend content for weaker areas.
  dimensionResults String?  @map("dimension_results") @db.NVarChar(Max)
  completedAt      DateTime @default(now()) @map("completed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("assessment_responses")
}

// ── Activity, devices, biometrics ────────────────────────────────────────────
// Biometrics are personal tracking; rewards are participation-based.

model ActivityType {
  id            Int     @id @default(autoincrement())
  slug          String  @unique @db.NVarChar(100)
  name          String  @db.NVarChar(200)
  /// points category (see src/lib/domain.ts)
  category      String  @db.NVarChar(30)
  /// steps | active_minutes | distance_miles | servings | count
  metric        String  @db.NVarChar(30)
  unit          String  @db.NVarChar(20)
  pointsPerUnit Decimal @default(0) @map("points_per_unit") @db.Decimal(8, 4)
  isActive      Boolean @default(true) @map("is_active")

  entries ActivityEntry[]

  @@map("activity_types")
}

/// (user_id, source, external_id) is unique WHERE external_id IS NOT NULL —
/// a filtered index added by hand in the init migration.
model ActivityEntry {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.NVarChar(64)
  activityTypeId Int      @map("activity_type_id")
  entryDate      DateTime @map("entry_date") @db.Date
  value          Decimal  @db.Decimal(12, 2)
  /// manual | device | import | admin
  source         String   @default("manual") @db.NVarChar(20)
  externalId     String?  @map("external_id") @db.NVarChar(200)
  verified       Boolean  @default(false)
  notes          String?  @db.NVarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, entryDate])
  @@map("activity_entries")
}

model DeviceConnection {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.NVarChar(64)
  /// apple_health | health_connect | fitbit | garmin | ...
  provider       String    @db.NVarChar(50)
  externalUserId String?   @map("external_user_id") @db.NVarChar(200)
  /// connected | error | disconnected
  status         String    @default("connected") @db.NVarChar(20)
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastError      String?   @map("last_error") @db.NVarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, provider])
  @@map("device_connections")
}

model BiometricScreening {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id") @db.NVarChar(64)
  screenedOn DateTime  @map("screened_on") @db.Date
  /// onsite | lab | physician_form | self_reported
  source     String    @default("self_reported") @db.NVarChar(30)
  verifiedBy String?   @map("verified_by") @db.NVarChar(200)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  results BiometricResult[]

  @@index([userId])
  @@map("biometric_screenings")
}

/// One row per marker (bp_systolic, ldl, a1c, bmi, waist_in, ...).
model BiometricResult {
  id          Int     @id @default(autoincrement())
  screeningId Int     @map("screening_id")
  marker      String  @db.NVarChar(50)
  value       Decimal @db.Decimal(8, 2)
  unit        String  @db.NVarChar(20)

  screening BiometricScreening @relation(fields: [screeningId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([screeningId, marker])
  @@map("biometric_results")
}

/// A member's personal target for one marker (their own tracking; never affects rewards).
model BiometricGoal {
  userId    String   @map("user_id") @db.NVarChar(64)
  marker    String   @db.NVarChar(50)
  target    Decimal  @db.Decimal(8, 2)
  /// below | above: which side of the target is the goal
  direction String   @db.NVarChar(10)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, marker])
  @@map("biometric_goals")
}

// ── Challenges ───────────────────────────────────────────────────────────────
// type: leaderboard | target | streak | stick_to_it | race | group_goal
// teamMode: individual | team | hybrid
// status: draft | scheduled | active | completed | archived

model ChallengeTemplate {
  id             Int      @id @default(autoincrement())
  slug           String   @unique @db.NVarChar(100)
  name           String   @db.NVarChar(200)
  description    String?  @db.NVarChar(1000)
  type           String   @db.NVarChar(20)
  /// steps | active_minutes | distance_miles | habit_checkins | workouts | custom
  metric         String   @db.NVarChar(30)
  unit           String   @db.NVarChar(20)
  goalValue      Decimal? @map("goal_value") @db.Decimal(12, 2)
  durationDays   Int      @default(28) @map("duration_days")
  imageUrl       String?  @map("image_url") @db.NVarChar(1000)
  /// JSON: pre-written comms { launch, weekly, final }
  communications String?  @db.NVarChar(Max)

  challenges Challenge[]

  @@map("challenge_templates")
}

model Challenge {
  id                 Int      @id @default(autoincrement())
  templateId         Int?     @map("template_id")
  slug               String   @unique @db.NVarChar(150)
  name               String   @db.NVarChar(200)
  description        String?  @db.NVarChar(1000)
  type               String   @db.NVarChar(20)
  metric             String   @db.NVarChar(30)
  unit               String   @db.NVarChar(20)
  goalValue          Decimal? @map("goal_value") @db.Decimal(12, 2)
  /// For streak / stick_to_it: the per-day amount that counts as a "day".
  dailyGoal          Decimal? @map("daily_goal") @db.Decimal(12, 2)
  /// Max value per user per day that counts toward the challenge.
  dailyCap           Decimal? @map("daily_cap") @db.Decimal(12, 2)
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  teamMode           String   @default("individual") @map("team_mode") @db.NVarChar(20)
  minTeamSize        Int?     @map("min_team_size")
  maxTeamSize        Int?     @map("max_team_size")
  pointsOnCompletion Int      @default(0) @map("points_on_completion")
  status             String   @default("draft") @db.NVarChar(20)
  imageUrl           String?  @map("image_url") @db.NVarChar(1000)
  /// JSON: e.g. { memberTypes: ["employee"], departments: [...] }
  eligibility        String?  @db.NVarChar(Max)
  /// Admin user id (no FK: keeps history if the admin account is removed).
  createdBy          String?  @map("created_by") @db.NVarChar(64)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  template    ChallengeTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  milestones  ChallengeMilestone[]
  teams       Team[]
  enrollments ChallengeEnrollment[]
  progress    ChallengeProgressDaily[]

  @@index([startDate, endDate])
  @@map("challenges")
}

model ChallengeMilestone {
  id          Int     @id @default(autoincrement())
  challengeId Int     @map("challenge_id")
  threshold   Decimal @db.Decimal(12, 2)
  label       String  @db.NVarChar(200)
  points      Int     @default(0)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("challenge_milestones")
}

model Team {
  id          Int      @id @default(autoincrement())
  /// Null = a standing team (e.g. a department) reusable across challenges.
  challengeId Int?     @map("challenge_id")
  name        String   @db.NVarChar(200)
  department  String?  @db.NVarChar(200)
  /// NoAction: clear captainId in app code before deleting a user.
  captainId   String?  @map("captain_id") @db.NVarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  challenge   Challenge?            @relation(fields: [challengeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  captain     User?                 @relation(fields: [captainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     TeamMember[]
  enrollments ChallengeEnrollment[]

  @@map("teams")
}

model TeamMember {
  teamId   Int      @map("team_id")
  userId   String   @map("user_id") @db.NVarChar(64)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([teamId, userId])
  @@map("team_members")
}

model ChallengeEnrollment {
  challengeId Int       @map("challenge_id")
  userId      String    @map("user_id") @db.NVarChar(64)
  /// NoAction (challenge → teams → enrollments would be a second cascade path).
  teamId      Int?      @map("team_id")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([challengeId, userId])
  @@index([userId])
  @@map("challenge_enrollments")
}

/// Per-user per-day progress (already capped). Team boards rank by AVERAGE per member.
model ChallengeProgressDaily {
  id          Int      @id @default(autoincrement())
  challengeId Int      @map("challenge_id")
  userId      String   @map("user_id") @db.NVarChar(64)
  day         DateTime @db.Date
  value       Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([challengeId, userId, day])
  @@map("challenge_progress_daily")
}

// ── Points & rewards (participation-based) ───────────────────────────────────

/// Admin-configurable earning rules per plan year (Wellable-style caps).
model PointsRule {
  id         Int     @id @default(autoincrement())
  planYear   Int     @map("plan_year")
  slug       String  @db.NVarChar(100)
  label      String  @db.NVarChar(200)
  category   String  @db.NVarChar(30)
  points     Int
  maxPerDay  Int?    @map("max_per_day")
  maxPerYear Int?    @map("max_per_year")
  isActive   Boolean @default(true) @map("is_active")

  ledger PointsLedger[]

  @@unique([planYear, slug])
  @@map("points_rules")
}

/// Append-only. Corrections are new rows with category "adjustment".
/// (user, sourceType, sourceId) is unique so awarding is idempotent.
model PointsLedger {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.NVarChar(64)
  planYear    Int      @map("plan_year")
  category    String   @db.NVarChar(30)
  points      Int
  ruleId      Int?     @map("rule_id")
  sourceType  String   @map("source_type") @db.NVarChar(50)
  sourceId    String   @map("source_id") @db.NVarChar(100)
  description String   @db.NVarChar(500)
  occurredOn  DateTime @map("occurred_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rule PointsRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, planYear])
  @@map("points_ledger")
}

model RewardTier {
  id        Int    @id @default(autoincrement())
  planYear  Int    @map("plan_year")
  threshold Int
  label     String @db.NVarChar(100)
  reward    String @db.NVarChar(300)
  sortOrder Int    @default(0) @map("sort_order")

  redemptions RewardRedemption[]

  @@map("reward_tiers")
}

model RewardRedemption {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.NVarChar(64)
  tierId      Int?      @map("tier_id")
  /// pending | fulfilled | cancelled
  status      String    @default("pending") @db.NVarChar(20)
  /// JSON
  details     String?   @db.NVarChar(Max)
  requestedAt DateTime  @default(now()) @map("requested_at")
  fulfilledAt DateTime? @map("fulfilled_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tier RewardTier? @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("reward_redemptions")
}

// ── Events & audit ───────────────────────────────────────────────────────────

model Event {
  id          Int       @id @default(autoincrement())
  title       String    @db.NVarChar(300)
  provider    String?   @db.NVarChar(200)
  description String?   @db.NVarChar(Max)
  eventDate   DateTime  @map("event_date") @db.Date
  startTime   DateTime? @map("start_time") @db.Time
  endTime     DateTime? @map("end_time") @db.Time
  location    String?   @db.NVarChar(300)
  url         String?   @db.NVarChar(1000)
  eventType   String    @default("webinar") @map("event_type") @db.NVarChar(30)
  /// Points for attending (a "special activity").
  points      Int       @default(0)

  @@index([eventDate])
  @@map("events")
}

/// Who touched what. No FK on actor so history survives account removal.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.NVarChar(64)
  action    String   @db.NVarChar(100)
  entity    String   @db.NVarChar(100)
  entityId  String?  @map("entity_id") @db.NVarChar(100)
  /// JSON
  metadata  String?  @db.NVarChar(Max)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}
