# SQL Server connection. Kept as separate values so passwords with special
# characters (? ; { }) need no escaping.
DB_SERVER=sql.example.internal
DB_PORT=1433
DB_NAME=WellnessPortal
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# true only for servers using a self-signed certificate
DB_TRUST_SERVER_CERTIFICATE=false

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: City SSO via Microsoft Entra ID. Leave blank to hide the button.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Production auth secret, used by infra/deploy.sh (stored in Azure Key Vault)
PROD_BETTER_AUTH_SECRET=
